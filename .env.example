# Supabase Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Store & Auth Flags
NEXT_PUBLIC_USE_DEMO_STORE=false
NEXT_PUBLIC_USE_SUPABASE_AUTH=false

# Security & API Tokens
OS_API_TOKEN=your-os-api-token-here
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# Web & Domain Configuration
WEB_ORIGIN=https://www.elevates.live
