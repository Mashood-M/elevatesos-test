NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo store (default). Set false to bootstrap from Supabase.
NEXT_PUBLIC_USE_DEMO_STORE=true

# Real Supabase Auth + middleware session guard. Keep false for persona demo.
NEXT_PUBLIC_USE_SUPABASE_AUTH=false

# Shared secret for Elevates-web → OS public write endpoints
OS_API_TOKEN=change-me-os-api-token

# Elevates-web revalidation webhook
WEB_REVALIDATE_URL=https://www.elevates.live/api/revalidate
WEB_REVALIDATE_SECRET=change-me-revalidate-secret
WEB_ORIGIN=https://www.elevates.live
