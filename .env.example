NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Demo store (default). Set false to bootstrap org/chapters from Supabase.
NEXT_PUBLIC_USE_DEMO_STORE=true

# Real Supabase Auth + middleware session guard. Keep false for persona demo.
NEXT_PUBLIC_USE_SUPABASE_AUTH=false
